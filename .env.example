# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit it.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults defined in src/config.py)
# CLAUDE_MODEL=claude-sonnet-4-6
# SUMMARY_MODEL=claude-haiku-4-5-20251001
# WHISPER_MODEL=small
# WAKE_WORD_THRESHOLD=0.5

# Microphone pin (optional). Blank ⇒ Jarvis uses the Windows DEFAULT input.
# Set this to a device-NAME substring (case-insensitive, e.g. "MC1000") or an
# integer device index to pin capture to a specific mic. Recommended for a
# DEDICATED Jarvis-only mic: pin by name so the mic need not be your system
# default (leaving your headset/etc. free for normal use) and a USB
# re-enumeration can't silently reroute Jarvis to the wrong input. Both the
# main capture and acoustic awareness honour this. A name that matches nothing
# logs a warning and falls back to the default mic (never fails to capture).
# JARVIS_MIC_DEVICE=MC1000

# Cap on torch's thread pool for acoustic awareness (PANNs) inference. Default
# 1 — an uncapped inference pins all CPU cores and starves the real-time audio
# threads, causing `input overflow` / TTS stutter. Mirror of JARVIS_YOLO_THREADS.
# JARVIS_ACOUSTIC_THREADS=1

# Memory tunables
# MEMORY_RECALL_COUNT=25   # recent session summaries to inject into system prompt
# RETAIN_RAW_DAYS=365      # delete raw transcripts older than this on startup
#                          # (raw is the corpus recall_conversation searches;
#                          #  set 0 to keep forever / never prune)

# Prediction follow-ups (M78.2 — "you called it" callbacks in the briefing).
# Jarvis mines sports predictions from past transcripts, resolves decided ones
# via web search, and surfaces them in the morning briefing. On by default.
# JARVIS_PREDICTION_FOLLOWUPS=1            # set 0 to disable entirely
# JARVIS_PREDICTION_MINE_MODEL=<model>     # extraction; default SUMMARY_MODEL (Haiku)
# JARVIS_PREDICTION_RESOLVE_MODEL=<model>  # judgment; default CLAUDE_MODEL (Sonnet)

# Quiet hours / Do-Not-Disturb (M79). During this window, ROUTINE status-
# monitoring announcements (the homelab monitor) are held back and surfaced in
# the morning briefing's "while you were away" catch-up. IMPORTANT announces
# still pierce — security, reminders, severe weather, acoustic alerts, calendar
# reminders, presence greetings. Unset/blank = off (every announce speaks).
# Overnight windows (start > end) wrap across midnight.
# JARVIS_QUIET_HOURS=22:00-08:00

# Plex Media Server (M21 — optional). If both are set, Jarvis spawns
# plex-mcp-server over stdio at startup and exposes media tools to Claude.
# If unset or unreachable, Jarvis runs without Plex tools (graceful fallback).
# PLEX_URL=http://192.168.1.x:32400
# PLEX_TOKEN=your-plex-x-plex-token-here

# RAWG (M22 — optional). Powers the get_game_info tool: release dates, game
# summaries, popular titles, recommendations. Free key — sign up at
# https://rawg.io/apidocs (email + password, no credit card; 20k req/month).
# If unset, Jarvis still runs but the games tool returns a clear error.
# RAWG_API_KEY=your-rawg-api-key-here

# TMDB (M43 — optional). Powers the get_movie_tv_info tool: movie/TV release
# and air dates, plot summaries, cast, ratings, trending titles, and
# recommendations. Free key, no credit card — sign up at
# https://www.themoviedb.org/signup then request a key under Settings → API
# (https://www.themoviedb.org/settings/api). Use the "API Key (v3 auth)"
# value (the short key, not the long v4 bearer token). Read at call time, so
# it's hot-swappable without restarting Jarvis. If unset, Jarvis still runs
# but the movie/TV tool returns a clear error.
# TMDB_API_KEY=your-tmdb-api-key-here
#
# Region for "where can I watch X?" (mode=providers — M73). Streaming/rent/buy
# availability is per-country (TMDB keys it by ISO-3166-1 code: US, GB, MX, …),
# so this picks which country's listings to read back. Defaults to US if unset.
# TMDB_WATCH_REGION=US

# News headlines (M47). The get_news tool needs NO API key — it reads a
# curated set of reputable RSS feeds (BBC, NPR, Ars Technica, The Verge,
# Hacker News) bucketed into topics: top / world / tech / business /
# science. There is nothing to configure here; the feed list lives in
# src/news.py (edit that map to add or swap sources — you control them).
# Listed only so it's discoverable alongside the other data tools.

# Severe-weather proactive alerts (M77 — US only, no API key). When
# JARVIS_HOME_LOCATION is set, Jarvis watches the National Weather Service
# active-alerts feed (api.weather.gov) for that area and warns you on its own
# before a severe storm — with a "no-UPS, consider shutting down" nudge for
# power-threatening events. Also exposes an on-demand get_weather_alerts tool.
#   JARVIS_WEATHER_ALERTS         — 0/false/off to DISABLE (default ON when a
#                                   home location is configured).
#   JARVIS_WEATHER_ALERT_SEVERITY — lowest severity to announce proactively:
#                                   "extreme", "severe" (default), or
#                                   "moderate" (adds advisories — noisier).
#   JARVIS_WEATHER_POLL_SECONDS   — seconds between polls (default 600, min 60).
# Uses JARVIS_HOME_LOCATION (set above for the briefing) — no separate location.
# JARVIS_WEATHER_ALERT_SEVERITY=severe

# WolframAlpha (M49 — optional). Powers the wolfram_query tool: precise
# computation — non-trivial arithmetic, unit/currency conversion, date math,
# equations, calculus, statistics, and scientific/physical/astronomical
# data. Free non-commercial key, no credit card: sign up at
# https://developer.wolframalpha.com/ , create an app (any name), and copy
# its AppID. The free tier allows 2,000 calls/month — ample for personal
# voice use. Read at call time, so it's hot-swappable without restarting
# Jarvis. If unset, Jarvis still runs but wolfram_query returns a clear
# "set WOLFRAM_APP_ID" message.
# WOLFRAM_APP_ID=your-wolframalpha-appid-here

# Remote console (M48 — optional, LAN-only). A phone/web console: type to
# Jarvis + get replies, see his state, and ARM/DISARM security remotely
# (e.g. you forgot to arm him on the way out). It's a thin client to THIS
# PC's brain over a WebSocket — Jarvis is not "installed" on the phone.
#
#   JARVIS_REMOTE_TOKEN — shared secret the phone must present. **BLANK =
#     the remote console is DISABLED and its server never starts** (safe
#     default: a surface that can disarm your security only exists once you
#     deliberately set a secret). Pick a long random string; you enter it
#     once on the phone and the browser remembers it.
#   JARVIS_REMOTE_PORT — TCP port (default 8765).
#   JARVIS_REMOTE_BIND — interface (default 0.0.0.0 = LAN-reachable).
#
# Security posture: LAN-only without TLS; LAN+off-LAN with TLS via Tailscale
# (see the JARVIS_TLS_* block below). The token + a Windows Firewall inbound
# rule SCOPED TO YOUR LAN SUBNET (or Tailscale's adapter) are the controls.
# **Never port-forward this** — off-LAN access is meant to ride Tailscale's
# encrypted WireGuard tunnel, not a public port.
# JARVIS_REMOTE_TOKEN=
# JARVIS_REMOTE_PORT=8765
# JARVIS_REMOTE_BIND=0.0.0.0

# TLS for the remote console (M48.3 prereq — optional but strongly
# recommended once Tailscale is up). Set BOTH to enable HTTPS/WSS on the
# server; either missing ⇒ falls back to plain HTTP/WS (LAN-mode dev path,
# never a crashed Jarvis on a misconfigured cert).
#
# Why HTTPS matters here, not just "encryption":
#   - **Secure context** unlocks `getUserMedia` → push-to-talk (M48.3) works.
#   - **iOS <audio> gesture rules relax** → reply audio plays without the
#     one-tap-per-session ▶︎ unlock (M48.2b's accepted UX limitation lifts).
#   - **PWA Add-to-Home-Screen** gets a proper app lifecycle (much better
#     reconnect behaviour on Edge in particular; chromeless on Safari).
#   - **Off-LAN access** via Tailscale, with a real trusted cert and zero
#     port-forwarding.
#
# Recommended path: run `tailscale cert <your-pc>.<tailnet>.ts.net` (after
# enabling HTTPS in the Tailscale admin console → DNS). It mints a real
# Let's Encrypt cert in the current directory. Stash the pair in
# %LOCALAPPDATA%\Jarvis\tls\ (out of the repo — these are CREDENTIALS;
# .gitignore also catches *.crt/*.key as belt-and-suspenders) and point
# the .env paths at them.
#
# Auto-renewal: Tailscale renews automatically every ~60 days; Jarvis only
# reads the files at startup, so re-running `tailscale cert` on the same
# files near expiry + restarting Jarvis is enough. Not auto-reloaded
# (deliberately simple; revisit if it ever bites).
# JARVIS_TLS_CERT_FILE=C:\Users\you\AppData\Local\Jarvis\tls\your-pc.tail1234.ts.net.crt
# JARVIS_TLS_KEY_FILE=C:\Users\you\AppData\Local\Jarvis\tls\your-pc.tail1234.ts.net.key

# Geofenced auto-arm (M70 — optional). Your phone's location auto-arms security
# when you leave home and disarms + greets you ("Welcome home, sir") when you
# return — closing the one friction point in the security flow (remembering to
# arm it). NO separate enable flag: this rides the SAME token-gated remote
# console above, so it exists exactly when JARVIS_REMOTE_TOKEN is set.
#
# How it works: geofencing is OFFLOADED to iOS (it does battery-efficient,
# native, hysteresis-buffered geofence detection far better than a web app
# could — PWA background geolocation is crippled on iOS, and WiFi/Tailscale
# presence can't tell home-from-away since the tunnel stays up on cellular).
# Jarvis just exposes a thin endpoint; the phone supplies the "am I home?"
# signal. The endpoint is hit with the SAME JARVIS_REMOTE_TOKEN as the console
# (**GET only** — the websockets HTTP shim rejects POST; GET is the Shortcuts
# default anyway):
#   GET  https://<your-pc>.<tailnet>.ts.net:8765/presence?event=leave
#   GET  https://<your-pc>.<tailnet>.ts.net:8765/presence?event=arrive
# Token via header (preferred): `Authorization: Bearer <JARVIS_REMOTE_TOKEN>`.
#
# ── iPhone setup (one-time, ~3 min) ──────────────────────────────────────
#   1. Shortcuts app → Automation tab → + → "When I Leave" → pick Home (or any
#      region) → set "Run Immediately" (so it fires with no tap).
#   2. Add action "Get Contents of URL":
#        URL    : https://<your-pc>.<tailnet>.ts.net:8765/presence?event=leave
#        Method : GET  (default; POST is rejected by the websockets HTTP shim)
#        Headers: Authorization = Bearer <your JARVIS_REMOTE_TOKEN>
#   3. Repeat with a second automation: "When I Arrive" → ...?event=arrive.
#   Off-LAN works because the URL is your Tailscale MagicDNS name (the tunnel
#   reaches your PC from anywhere). On plain-LAN-http it also works at home;
#   for it to fire while genuinely away you need the Tailscale/TLS path above.
#
# JARVIS_PRESENCE_ARM_DELAY — seconds to DEFER the auto-arm after a "leave"
# ping, cancelled if an "arrive" lands first. This damps geofence boundary-flap
# (skirting the edge fires leave→arrive within seconds, which would otherwise
# arm-then-disarm and greet you on your own couch). The iOS geofence is already
# ~100 m out, so a minute's delay after you've physically left costs nothing.
# Set 0 to arm the instant the "leave" ping arrives. Default 60.
# JARVIS_PRESENCE_ARM_DELAY=60
#
# JARVIS_PRESENCE_GREETING — what Jarvis says on an arrive that disarms an
# armed house (never on a spurious arrive to an already-disarmed one).
# JARVIS_PRESENCE_GREETING=Welcome home, sir.

# Personal knowledge base (M45 — optional). The knowledge_search tool lets
# Jarvis answer questions about YOUR private setup — homelab topology, the
# Plex/MEDIA-HOST runbook, 3D-printer profiles, work notes, anything
# you teach him with "Jarvis, remember this permanently: ...".
#
# Two stores, separated by design:
#   Corpus — the source of truth: plain *.md / *.txt files in this folder.
#            git-versioned (own repo, the standard repo convention) so it's
#            backed up offsite like every other repo. THIS is what survives a
#            disk death.
#   Index  — a rebuildable SQLite FTS5 cache at %LOCALAPPDATA%\Jarvis\
#            knowledge.db. Regenerated from the corpus by "Jarvis, update
#            your knowledge" (or the tray "Reindex knowledge" item). Not
#            versioned — disposable, like a search engine's index.
#
# Default corpus location is ~/repos/jarvis-knowledge (created on first
# "remember this permanently"). Read at call time, so cloning the repo into
# place needs no Jarvis restart. Set this only to override the location.
# If the folder is absent, Jarvis still runs; the tool just reports it's empty.
# JARVIS_KNOWLEDGE_DIR=

# Plex laptop SSH (M24 — optional). Enables read-only diagnostic tools that
# reach the Plex laptop over SSH: plex_logs_tail, plex_logs_search,
# plex_laptop_health. Auth is ed25519 key-based; password auth is disabled
# on the laptop's sshd_config (see milestone 24 for setup).
#
# If HOST/USER are unset, Jarvis runs without the M24 tools. Connection is
# lazy — the laptop being off only affects calls to those specific tools.
# PLEX_LAPTOP_HOST=192.168.1.10
# PLEX_LAPTOP_USER=youruser
# Optional — defaults to ~/.ssh/id_ed25519
# PLEX_LAPTOP_KEY_PATH=
# Optional — overrides the default Plex log path on the laptop. Default is
# C:\Users\<PLEX_LAPTOP_USER>\AppData\Local\Plex Media Server\Logs\Plex Media Server.log
# PLEX_LAPTOP_LOG_PATH=

# Diagnostics collector script (M28 — optional). The run_pc_diagnostics_collector
# tool shells out to the Invoke-HSWindowsDiagnostics.ps1 script. Default location
# is ~/repos/hs-windows-diagnostics/Invoke-HSWindowsDiagnostics.ps1; set this only
# if the script lives elsewhere. If the script isn't found, the tool says so and
# the live pc_diagnostics tool still works.
# DIAGNOSTICS_COLLECTOR_PATH=

# Webcam device index for the camera_snapshot tool (M29 — optional). Default 0
# (the first/only camera). Set this only if you have several cameras and want
# Jarvis to use a different one.
# CAMERA_INDEX=0

# Security-mode voice passphrase (M35 — optional but recommended).
# When the security watcher detects a person, Jarvis prompts "Please identify
# yourself within the next 15 seconds, sir." You say "Hey Jarvis" + your
# passphrase to authenticate. Fuzzy match (difflib SequenceMatcher ≥ 0.7) so
# minor Whisper transcription wobble still passes. Pick a 2-4 word phrase
# Whisper can transcribe reliably — avoid rare names, numbers, or homophones.
# If unset, the challenge step is skipped (M34 announce-only behavior).
# JARVIS_SECURITY_PASSPHRASE=your-passphrase-here

# STT GPU offload server (M36 — optional). If set, Jarvis posts captured
# audio to this URL for GPU transcription (typically 250-500ms vs 5-10s
# local CPU). Auto-falls back to local CPU silently on any failure
# (server unreachable, network blip, etc.).
# STT_SERVER_URL=http://192.168.1.10:8000

# STT backend selection (M36 — optional). Default "auto".
#   auto — try GPU server first, fall back to local CPU silently on failure
#   gpu  — force GPU server, error clearly if unreachable (no fallback)
#   cpu  — force local CPU (M35 behavior; useful for testing or if you don't
#          have a GPU host available)
# STT_BACKEND=auto

# Discord webhook for security-mode deterrent alerts (M38 — optional but
# recommended). When the M35 deterrent fires (15s challenge timeout), this
# webhook receives a push with the evidence snapshot attached. Free,
# instant, phone notifications via the Discord mobile app.
#
# To create the webhook:
#   1. Open the Discord channel where you want alerts to appear.
#   2. Edit Channel → Integrations → Webhooks → New Webhook.
#   3. Name it (e.g. "Jarvis"), copy the URL, paste below.
#   4. The URL is a secret — treat it like a password. Anyone with it can
#      post to your channel.
#
# If unset, the deterrent still fires + saves local evidence (M35 behavior);
# you just don't get a push notification.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abc...

# Reminder Discord push (2026-06-02). When DISCORD_WEBHOOK_URL is set, a
# reminder ALSO posts its text to that webhook the moment it fires — so a
# reminder reaches you when you're away from the PC, not just spoken to an
# empty room. Includes scheduled briefings / good-night wraps (the full
# composed text is pushed too). On by default whenever the webhook is set;
# there's no home/away detection, so it always pushes (harmless redundancy
# when you're home — mute the channel if you like). Set to 0 to disable.
# JARVIS_REMINDER_DISCORD=0

# Discord BOT bridge (2026-06-02) — talk to Jarvis two-way from a Discord
# channel (you + anyone you allowlist, e.g. a partner). Distinct from the
# one-way webhook above: this needs a BOT (a token + the Gateway connection).
# It rides the same channel you already use; the webhook (reminders) and the
# bot (conversation) coexist fine. The bot only starts if ALL THREE below are
# set (fail-closed: no allowlist ⇒ nobody can drive it, never everybody).
#
# Origin "discord" is RESTRICTED (no system/shell/file/code tools) and
# text-only (replies post to the channel; the PC never speaks). Outbound
# gateway connection ⇒ no port-forward / Tailscale needed, works off-network.
#
# Setup (one-time, ~10 min):
#   1. https://discord.com/developers/applications → New Application → Bot.
#   2. Bot tab → Reset Token → copy → DISCORD_BOT_TOKEN below. (The ONLY
#      secret of the three — guard it; it's shown once, Reset if lost.)
#   3. Bot tab → enable the "MESSAGE CONTENT INTENT" toggle (required — without
#      it the bot connects but sees empty message text). Save.
#   4. OAuth2 → URL Generator → scope `bot` + perms View Channels / Send
#      Messages / Read Message History → open the URL → add it to your server.
#   5. In the Discord app: Settings → Advanced → Developer Mode ON, then
#      right-click your channel → Copy Channel ID, and right-click each allowed
#      person → Copy User ID.
# DISCORD_BOT_TOKEN=your-bot-token-here
# DISCORD_CHANNEL_ID=123456789012345678
# DISCORD_ALLOWED_USER_IDS=111111111111111111,222222222222222222

# SMTP email alert for security-mode deterrent (M38 — optional, parallel to
# Discord). Fires in addition to Discord when the deterrent triggers — both
# channels are independent, so a Discord outage doesn't suppress email and
# vice versa. Send the evidence JPEG as an attachment.
#
# For Gmail (the default host/port below):
#   1. Enable 2-Step Verification on your Google account (required by Google
#      to use SMTP — your normal password will NOT work).
#   2. https://myaccount.google.com/security → App passwords → create one
#      named "Jarvis". Google shows a 16-char string (e.g. "abcd efgh ijkl
#      mnop") — strip the spaces and use that as SMTP_PASSWORD.
#   3. SMTP_USERNAME is the full Gmail address (the From).
#   4. SMTP_TO accepts a single address or a comma-separated list.
#
# Host/port defaults to Gmail (smtp.gmail.com:587 STARTTLS). For other
# providers: Outlook = smtp-mail.outlook.com:587; Fastmail = smtp.fastmail.com:465.
# Port 465 selects implicit SSL automatically; any other port uses STARTTLS.
#
# If SMTP_USERNAME or SMTP_TO is unset, the email path is silently skipped
# (Discord-only behavior). All three of USERNAME/PASSWORD/TO must be set to
# enable email alerts.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_TO=recipient@example.com

# Face-recognition match threshold (M39 — optional). Euclidean distance
# below which a detected face is considered a match against the enrolled
# encoding at %LOCALAPPDATA%\Jarvis\security\face_encoding.npy. Lower =
# stricter; higher = more permissive.
#   0.4  ~ very strict, may reject valid matches in poor light or off-angle
#   0.5  ~ recommended for security (Jarvis default)
#   0.6  ~ face_recognition's permissive default (photo-album use)
# If no encoding is enrolled, the face-auth path is silently disabled and
# CHALLENGE state falls back to voice passphrase only (M35 behavior).
# JARVIS_FACE_MATCH_THRESHOLD=0.5

# Memory watchdog (M44 / M44.2 — optional). While security is armed, the
# watcher checks memory each poll; on breach Jarvis logs "MEMORY WATCHDOG
# TRIPPED", speaks a heads-up, and auto-disarms. Two independent triggers:
#
# JARVIS_MEMORY_WATCHDOG_MB — this PROCESS's private/commit bytes ceiling.
#   M44.2: the guard was RSS-based and never tripped — the leak grows COMMIT
#   bytes and Windows trims the working set under pressure, so RSS stayed low
#   while commit hit 37 GB and the machine locked up. Now it watches private
#   bytes (the metric that actually grew). Armed baseline ~1.5-2 GB private;
#   3500 catches a runaway within minutes (the leak ran to 37 GB), far below
#   danger. This is the load-bearing guard.
#   3500 ~ Jarvis default        |   <= 0 ~ this check disabled
#
# JARVIS_MEMORY_MIN_AVAIL_MB — SYSTEM available-memory floor. Secondary net
#   for leaks the process check can't see (e.g. an MCP child). Kept LOW: this
#   dev box idles ~1.2 GB available and arming loads ~1.5 GB of ML stack, so
#   a 1 GB floor would false-trip every arm (the M44.1 calibration trap). 512
#   is a deliberately conservative placeholder pending a real soak, not a
#   calibrated value. Raise it on a roomier machine.
#   512 ~ Jarvis default         |   <= 0 ~ this check disabled
#
# Set BOTH <= 0 to fully disable the watchdog.
# JARVIS_MEMORY_WATCHDOG_MB=3500
# JARVIS_MEMORY_MIN_AVAIL_MB=512

# YOLO inference thread cap (security mode — optional). torch defaults its
# intra-op pool to ALL physical cores, so a single 0.5 Hz watcher inference
# pins every core for ~200-400 ms; overlapping a TTS phrase that starves the
# audio threads and causes the armed-only speech stutter (diagnosed
# 2026-05-18). YOLOv8n on one frame every 2 s has a huge latency budget, so
# 1 thread (≈0.5-1 s/inference, still well inside the 2 s poll) trades
# irrelevant inference speed for free cores → clean audio. Default 1. Raise
# toward your core count only if inference latency ever becomes the actual
# constraint (it isn't at 0.5 Hz). <= 0 leaves torch uncapped (debug/parity).
# JARVIS_YOLO_THREADS=1

# Barge-in kill switch (M52 — optional). Barge-in lets you interrupt Jarvis
# mid-reply just by saying "Hey Jarvis": a wake-word monitor thread runs
# openWakeWord concurrently with TTS playback and, on detection, aborts the
# speech + the LLM stream and drops straight into listening. It is ON by
# default. Set this to 0 (or false/no/off) to disable it entirely — the
# escape hatch if the TTS-concurrent monitor is ever found to stutter the
# audio path (the documented stutter-gate risk; openWakeWord is light and
# the short live test was clean, but a multi-hour soak is the real proof).
# JARVIS_BARGE_IN=1

# Morning briefing home location (M55 — optional). The get_briefing tool
# ("Jarvis, good morning") includes today's weather for this place. Use any
# city/town name Open-Meteo's geocoder recognizes — 'Denver', 'Mexico City',
# 'London, UK'. If unset, the briefing still works — it just omits the
# weather line. JARVIS_HOME_UNITS picks the temperature scale: imperial =
# Fahrenheit (the default), metric = Celsius. Both are read at call time,
# so they're hot-swappable without restarting Jarvis.
# JARVIS_HOME_LOCATION=Denver
# JARVIS_HOME_UNITS=imperial

# Proactive homelab monitoring (M56 — optional). A background watcher that
# polls the homelab and speaks up ON ITS OWN when something breaks — the Plex
# laptop goes unreachable, Plex Media Server stops responding, or a disk runs
# low — and again when it recovers. Alerts are spoken (and pushed to Discord
# if DISCORD_WEBHOOK_URL is set). It needs PLEX_LAPTOP_HOST (above) to have
# anything to watch; the disk check additionally needs the SSH tools working.
#
# Default OFF — opt in here or via the tray's "Homelab monitoring" toggle.
# JARVIS_HOMELAB_MONITOR=1
#
# Tunables (all optional; sensible defaults in src/homelab_monitor.py):
#   JARVIS_HOMELAB_POLL_SECONDS   — seconds between sweeps (default 60, min 30)
#   JARVIS_HOMELAB_FAIL_THRESHOLD — consecutive failed polls before an alert
#       fires (default 3 — flap damping; a single dropped poll is noise). With
#       the defaults, a real outage is announced ~3 minutes in.
#   JARVIS_HOMELAB_DISK_MIN_PCT   — alert when a drive has less than this %
#       free (default 10)
#   JARVIS_HOMELAB_LABEL          — friendly name spoken in alerts (default
#       "the Plex laptop"; set e.g. "MEDIA-HOST")
# JARVIS_HOMELAB_POLL_SECONDS=60
# JARVIS_HOMELAB_FAIL_THRESHOLD=3
# JARVIS_HOMELAB_DISK_MIN_PCT=10
# JARVIS_HOMELAB_LABEL=MEDIA-HOST

# Acoustic awareness (M58 — optional). A background classifier listens to the
# mic (its own InputStream, separate from the wake-word loop) and speaks up on
# its own when it hears: a doorbell, a knock, a smoke alarm, glass breaking, a
# phone ringing, a kitchen timer, or a sink left running. Alerts ride 🔔 on
# the Announcer + push to DISCORD_WEBHOOK_URL if set. PANNs Cnn14 (~325 MB
# one-time download from Zenodo on first activate; cached to
# ~/panns_data/Cnn14_mAP=0.431.pth). Audio never leaves the box.
#
# Default OFF — opt in here or via the tray's "Acoustic awareness" toggle.
# JARVIS_ACOUSTIC_MONITOR=1
#
# Per-class kill switch: comma-separated list of class names to NEVER fire.
# Useful if one class proves noisy in your specific room without disabling
# the whole feature. Names: doorbell, knock, smoke_alarm, glass_break,
# phone_ringing, kitchen_timer, running_water, voice_while_armed.
# JARVIS_ACOUSTIC_DISABLE=running_water
#
# M81 — armed intrusion-by-voice. While security is ARMED (away), human speech
# in the supposedly-empty house fires a look + photo + Discord push (the M72
# visual alert). The voice_while_armed class is ARMED_ONLY — it never fires at
# home, only away, so normal conversation is never flagged. This is the summed
# "Speech"/"Conversation"/"Shout" score threshold; expect to live-tune it with
# JARVIS_ACOUSTIC_DEBUG=1 (speak in the room while armed, read the real scores,
# set this above the room's quiet/TV-bleed floor but below clear speech).
# Disable entirely with JARVIS_ACOUSTIC_DISABLE=voice_while_armed.
#   0.45 ~ default starting point
# JARVIS_ACOUSTIC_VOICE_THRESHOLD=0.45
#
# Running-water volume floor — the pet-fountain mitigation. The running_water
# class has a continuous-trickle false-positive problem if the room has a pet
# fountain or aquarium. We require BOTH high classifier confidence AND audio
# RMS above this floor; below it, even high-confidence "running water" is
# silently dropped (the fountain trickle is well below the floor; a sink left
# on full sits comfortably above it). Tune up if your fountain still triggers
# false alerts; tune down if a real sink-left-on doesn't fire.
#   0.025 ~ default (guessed-conservative; expect to calibrate against your
#           specific room after the first live test)
# JARVIS_ACOUSTIC_WATER_RMS_FLOOR=0.025

# Outlook calendar (M62.1 — optional). Read-only, via Outlook.com's published
# iCal feed: the morning briefing gains today's events, and Jarvis can answer
# "what's on my calendar today?", "what's tomorrow looking like?", "am I free
# at 3pm?" via the get_calendar_events tool. Jarvis CANNOT create or modify
# events (read-only). Calendar event metadata (subject, time, location) is
# fetched from the published feed on demand.
#
# (M62 originally also offered a Microsoft Graph backend via OUTLOOK_CLIENT_ID
# + an Azure app registration. It was removed in the 2026-05-29 QoL pass —
# unreachable here because the account's Entra tenant is auto-suspended
# ("AADSTS5000225: This tenant has been blocked due to inactivity"), which is
# exactly why the iCal path exists. Git history has the Graph code if needed.)
#
# HOW IT WORKS: Outlook.com lets you publish a calendar to a secret
# .ics URL. Jarvis fetches the URL on each query and parses it; the
# `recurring-ical-events` library expands recurring events into the
# requested date range (the client-side analog of Graph's
# /calendarView).
#
# SETUP (one-time, ~2 minutes):
#   1. Open https://outlook.live.com/calendar and sign in.
#   2. Settings (gear icon, top right) → "View all Outlook settings".
#   3. Calendar → Shared calendars → "Publish a calendar".
#   4. Pick the calendar to publish; permissions: "Can view all details"
#      (anything less hides event titles and locations from Jarvis).
#      Click Publish.
#   5. Copy the ICS link Outlook gives you (it ends in `.ics`).
#   6. Paste below as OUTLOOK_ICAL_URL.
#
# SECURITY: the URL is a long random token — anyone with it can read
# your calendar. Treat it like any other webhook URL: keep it out of
# git (the .gitignore already blocks .env). To revoke, go back to the
# publish settings and click "Stop publishing"; the URL becomes 404.
#
# CAVEAT: Outlook caches the published feed server-side, so updates can
# take up to a few hours to show. Acceptable for a daily briefing; if
# something just landed on your calendar five minutes ago Jarvis might
# not see it yet.
#
# OUTLOOK_ICAL_URL=https://outlook.live.com/owa/calendar/.../.../calendar.ics

# ─────────────────────────────────────────────────────────────────────
# M62.2 — pre-event proactive calendar reminders.
#
# When the calendar above is configured, Jarvis quietly watches the feed in
# the background and announces an event a fixed lead time before it starts:
# "Sir — your 2 pm standup in 15 minutes."
#
# Unlike the homelab / acoustic monitors (default OFF, opt-in), this is
# DEFAULT ON when calendar is configured — you already opted in by setting
# up calendar, the proactive layer IS the value-add.
#
# Kill switch — uncomment to disable even when calendar is configured:
# JARVIS_CALENDAR_REMINDERS=0
#
# Tunables (all optional; sensible defaults in src\calendar_monitor.py):
#   JARVIS_CALENDAR_LEAD_MIN       — minutes before start to announce
#       (default 15, min 1)
#   JARVIS_CALENDAR_POLL_SECONDS   — seconds between calendar polls
#       (default 60, min 30)
# JARVIS_CALENDAR_LEAD_MIN=15
# JARVIS_CALENDAR_POLL_SECONDS=60
#
# All-day events are deliberately skipped — the morning briefing (M55)
# already surfaces them. Dedupe state lives at
# %LOCALAPPDATA%\Jarvis\calendar_announced.json (one entry per fired
# event, pruned to entries < 24h on save) — so a restart between the
# announce and the meeting itself doesn't double-fire.

# Speaker identification (M69 — optional). Per-turn "who is speaking" via
# Resemblyzer voice embeddings (local; audio never leaves the box). Powers an
# opt-in "voice lock" gate that answers only ENROLLED voices and ignores the
# rest (e.g. the TV) — and per-speaker language hints. Identification activates
# simply by enrolling a voice ("Jarvis, enroll my voice" or the tray "Enroll my
# voice"); enroll others by typing in the console: "enroll voice Alice" /
# "enroll voice Bob in Spanish". Logs [speaker] recognized <name> (score=…).
#
# The name your primary voice enrolls under (shows in [speaker] logs).
# JARVIS_USER_NAME=Saul
#
# Recognize threshold (min cosine similarity). Default 0.60. Live data: the
# enrolled user scored 0.83-0.95 normally but 0.66 with a rough/hoarse voice,
# vs ~0.566 for background media — so 0.60 sits below the rough-voice floor
# (fail-open: never ignore the real user) while still rejecting media. The
# margin to media is tight (~0.03); raise toward 0.65 if the TV slips through,
# lower toward 0.55 if you ever get falsely ignored on a clean command.
# JARVIS_SPEAKER_THRESHOLD=0.60
#
# Voice-lock gate. Default OFF. When ON (here or via the tray "Voice lock"
# toggle) AND at least one voice is enrolled, a confidently-unrecognized VOICE
# turn is dropped. The typed/console path is NEVER gated (physical access =
# authorization), so you can't lock yourself out. Toggle live, no restart.
# JARVIS_SPEAKER_GATE=1
