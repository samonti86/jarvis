# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit it.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults defined in src/config.py)
# CLAUDE_MODEL=claude-sonnet-4-6
# SUMMARY_MODEL=claude-haiku-4-5-20251001
# WHISPER_MODEL=small
# WAKE_WORD_THRESHOLD=0.5

# Memory tunables
# MEMORY_RECALL_COUNT=10   # recent session summaries to inject into system prompt
# RETAIN_RAW_DAYS=30       # delete raw transcripts older than this on startup

# Plex Media Server (M21 — optional). If both are set, Jarvis spawns
# plex-mcp-server over stdio at startup and exposes media tools to Claude.
# If unset or unreachable, Jarvis runs without Plex tools (graceful fallback).
# PLEX_URL=http://192.168.1.x:32400
# PLEX_TOKEN=your-plex-x-plex-token-here

# RAWG (M22 — optional). Powers the get_game_info tool: release dates, game
# summaries, popular titles, recommendations. Free key — sign up at
# https://rawg.io/apidocs (email + password, no credit card; 20k req/month).
# If unset, Jarvis still runs but the games tool returns a clear error.
# RAWG_API_KEY=your-rawg-api-key-here

# TMDB (M43 — optional). Powers the get_movie_tv_info tool: movie/TV release
# and air dates, plot summaries, cast, ratings, trending titles, and
# recommendations. Free key, no credit card — sign up at
# https://www.themoviedb.org/signup then request a key under Settings → API
# (https://www.themoviedb.org/settings/api). Use the "API Key (v3 auth)"
# value (the short key, not the long v4 bearer token). Read at call time, so
# it's hot-swappable without restarting Jarvis. If unset, Jarvis still runs
# but the movie/TV tool returns a clear error.
# TMDB_API_KEY=your-tmdb-api-key-here

# News headlines (M47). The get_news tool needs NO API key — it reads a
# curated set of reputable RSS feeds (BBC, NPR, Ars Technica, The Verge,
# Hacker News) bucketed into topics: top / world / tech / business /
# science. There is nothing to configure here; the feed list lives in
# src/news.py (edit that map to add or swap sources — you control them).
# Listed only so it's discoverable alongside the other data tools.

# Personal knowledge base (M45 — optional). The knowledge_search tool lets
# Jarvis answer questions about YOUR private setup — homelab topology, the
# Plex/MEDIA-HOST runbook, 3D-printer profiles, work notes, anything
# you teach him with "Jarvis, remember this permanently: ...".
#
# Two stores, separated by design:
#   Corpus — the source of truth: plain *.md / *.txt files in this folder.
#            git-versioned (own repo, the standard repo convention) so it's
#            backed up offsite like every other repo. THIS is what survives a
#            disk death.
#   Index  — a rebuildable SQLite FTS5 cache at %LOCALAPPDATA%\Jarvis\
#            knowledge.db. Regenerated from the corpus by "Jarvis, update
#            your knowledge" (or the tray "Reindex knowledge" item). Not
#            versioned — disposable, like a search engine's index.
#
# Default corpus location is ~/repos/jarvis-knowledge (created on first
# "remember this permanently"). Read at call time, so cloning the repo into
# place needs no Jarvis restart. Set this only to override the location.
# If the folder is absent, Jarvis still runs; the tool just reports it's empty.
# JARVIS_KNOWLEDGE_DIR=

# Plex laptop SSH (M24 — optional). Enables read-only diagnostic tools that
# reach the Plex laptop over SSH: plex_logs_tail, plex_logs_search,
# plex_laptop_health. Auth is ed25519 key-based; password auth is disabled
# on the laptop's sshd_config (see milestone 24 for setup).
#
# If HOST/USER are unset, Jarvis runs without the M24 tools. Connection is
# lazy — the laptop being off only affects calls to those specific tools.
# PLEX_LAPTOP_HOST=192.168.1.10
# PLEX_LAPTOP_USER=youruser
# Optional — defaults to ~/.ssh/id_ed25519
# PLEX_LAPTOP_KEY_PATH=
# Optional — overrides the default Plex log path on the laptop. Default is
# C:\Users\<PLEX_LAPTOP_USER>\AppData\Local\Plex Media Server\Logs\Plex Media Server.log
# PLEX_LAPTOP_LOG_PATH=

# Diagnostics collector script (M28 — optional). The run_pc_diagnostics_collector
# tool shells out to the Invoke-HSWindowsDiagnostics.ps1 script. Default location
# is ~/repos/hs-windows-diagnostics/Invoke-HSWindowsDiagnostics.ps1; set this only
# if the script lives elsewhere. If the script isn't found, the tool says so and
# the live pc_diagnostics tool still works.
# DIAGNOSTICS_COLLECTOR_PATH=

# Webcam device index for the camera_snapshot tool (M29 — optional). Default 0
# (the first/only camera). Set this only if you have several cameras and want
# Jarvis to use a different one.
# CAMERA_INDEX=0

# Security-mode voice passphrase (M35 — optional but recommended).
# When the security watcher detects a person, Jarvis prompts "Please identify
# yourself within the next 15 seconds, sir." You say "Hey Jarvis" + your
# passphrase to authenticate. Fuzzy match (difflib SequenceMatcher ≥ 0.7) so
# minor Whisper transcription wobble still passes. Pick a 2-4 word phrase
# Whisper can transcribe reliably — avoid rare names, numbers, or homophones.
# If unset, the challenge step is skipped (M34 announce-only behavior).
# JARVIS_SECURITY_PASSPHRASE=your-passphrase-here

# STT GPU offload server (M36 — optional). If set, Jarvis posts captured
# audio to this URL for GPU transcription (typically 250-500ms vs 5-10s
# local CPU). Auto-falls back to local CPU silently on any failure
# (server unreachable, network blip, etc.).
# STT_SERVER_URL=http://192.168.1.10:8000

# STT backend selection (M36 — optional). Default "auto".
#   auto — try GPU server first, fall back to local CPU silently on failure
#   gpu  — force GPU server, error clearly if unreachable (no fallback)
#   cpu  — force local CPU (M35 behavior; useful for testing or if you don't
#          have a GPU host available)
# STT_BACKEND=auto

# Discord webhook for security-mode deterrent alerts (M38 — optional but
# recommended). When the M35 deterrent fires (15s challenge timeout), this
# webhook receives a push with the evidence snapshot attached. Free,
# instant, phone notifications via the Discord mobile app.
#
# To create the webhook:
#   1. Open the Discord channel where you want alerts to appear.
#   2. Edit Channel → Integrations → Webhooks → New Webhook.
#   3. Name it (e.g. "Jarvis"), copy the URL, paste below.
#   4. The URL is a secret — treat it like a password. Anyone with it can
#      post to your channel.
#
# If unset, the deterrent still fires + saves local evidence (M35 behavior);
# you just don't get a push notification.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abc...

# SMTP email alert for security-mode deterrent (M38 — optional, parallel to
# Discord). Fires in addition to Discord when the deterrent triggers — both
# channels are independent, so a Discord outage doesn't suppress email and
# vice versa. Send the evidence JPEG as an attachment.
#
# For Gmail (the default host/port below):
#   1. Enable 2-Step Verification on your Google account (required by Google
#      to use SMTP — your normal password will NOT work).
#   2. https://myaccount.google.com/security → App passwords → create one
#      named "Jarvis". Google shows a 16-char string (e.g. "abcd efgh ijkl
#      mnop") — strip the spaces and use that as SMTP_PASSWORD.
#   3. SMTP_USERNAME is the full Gmail address (the From).
#   4. SMTP_TO accepts a single address or a comma-separated list.
#
# Host/port defaults to Gmail (smtp.gmail.com:587 STARTTLS). For other
# providers: Outlook = smtp-mail.outlook.com:587; Fastmail = smtp.fastmail.com:465.
# Port 465 selects implicit SSL automatically; any other port uses STARTTLS.
#
# If SMTP_USERNAME or SMTP_TO is unset, the email path is silently skipped
# (Discord-only behavior). All three of USERNAME/PASSWORD/TO must be set to
# enable email alerts.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_TO=recipient@example.com

# Face-recognition match threshold (M39 — optional). Euclidean distance
# below which a detected face is considered a match against the enrolled
# encoding at %LOCALAPPDATA%\Jarvis\security\face_encoding.npy. Lower =
# stricter; higher = more permissive.
#   0.4  ~ very strict, may reject valid matches in poor light or off-angle
#   0.5  ~ recommended for security (Jarvis default)
#   0.6  ~ face_recognition's permissive default (photo-album use)
# If no encoding is enrolled, the face-auth path is silently disabled and
# CHALLENGE state falls back to voice passphrase only (M35 behavior).
# JARVIS_FACE_MATCH_THRESHOLD=0.5

# Memory watchdog (M44 / M44.2 — optional). While security is armed, the
# watcher checks memory each poll; on breach Jarvis logs "MEMORY WATCHDOG
# TRIPPED", speaks a heads-up, and auto-disarms. Two independent triggers:
#
# JARVIS_MEMORY_WATCHDOG_MB — this PROCESS's private/commit bytes ceiling.
#   M44.2: the guard was RSS-based and never tripped — the leak grows COMMIT
#   bytes and Windows trims the working set under pressure, so RSS stayed low
#   while commit hit 37 GB and the machine locked up. Now it watches private
#   bytes (the metric that actually grew). Armed baseline ~1.5-2 GB private;
#   3500 catches a runaway within minutes (the leak ran to 37 GB), far below
#   danger. This is the load-bearing guard.
#   3500 ~ Jarvis default        |   <= 0 ~ this check disabled
#
# JARVIS_MEMORY_MIN_AVAIL_MB — SYSTEM available-memory floor. Secondary net
#   for leaks the process check can't see (e.g. an MCP child). Kept LOW: this
#   dev box idles ~1.2 GB available and arming loads ~1.5 GB of ML stack, so
#   a 1 GB floor would false-trip every arm (the M44.1 calibration trap). 512
#   is a deliberately conservative placeholder pending a real soak, not a
#   calibrated value. Raise it on a roomier machine.
#   512 ~ Jarvis default         |   <= 0 ~ this check disabled
#
# Set BOTH <= 0 to fully disable the watchdog.
# JARVIS_MEMORY_WATCHDOG_MB=3500
# JARVIS_MEMORY_MIN_AVAIL_MB=512
