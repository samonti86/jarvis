# ─────────────────────────────────────────────────────────────────────────────
# Jarvis configuration
#
#   Copy to `.env` and set ANTHROPIC_API_KEY. That is the only required value.
#   Everything else is optional and OFF by default — Jarvis runs without it and
#   reports "not configured" rather than failing.
#
#   Full reference (every setting, its default, and where it's read):
#       docs/ENV_VARS.md
#   Step-by-step setup, including how to obtain each API key:
#       docs/SETUP.md
#   Check what's configured and what's missing:
#       python scripts/doctor.py
#
#   .env is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...


# ── COMMONLY SET ─────────────────────────────────────────────────────────────
# Weather, the morning briefing, and severe-weather alerts. "City, ST" or ZIP.
# JARVIS_HOME_LOCATION=Austin, TX
# JARVIS_HOME_UNITS=imperial          # imperial | metric

# Pin the microphone by name-substring or index. Blank = Windows default.
# Recommended if you have more than one input device.
# JARVIS_MIC_DEVICE=MC1000

# What Jarvis calls you, and the name your enrolled voice is stored under.
# JARVIS_USER_NAME=Saul


# ── MODELS ───────────────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-5              # main conversation model
# SUMMARY_MODEL=claude-haiku-4-5-20251001   # cheap model for background jobs
# WHISPER_MODEL=small                       # local faster-whisper size
# WAKE_WORD_THRESHOLD=0.5                   # lower = more sensitive


# ── OPTIONAL FEATURES (all default OFF) ──────────────────────────────────────
# JARVIS_HUD=1                     # translucent arc-reactor overlay
# JARVIS_ANTICIPATION=1            # proactive cross-domain insights (LLM polls)
# JARVIS_HOMELAB_MONITOR=1         # watch a host/service, speak on state change
# JARVIS_ACOUSTIC_MONITOR=1        # ambient sound classification (doorbell, alarm)
# JARVIS_QUIET_HOURS=22:00-08:00   # defer ROUTINE announces; important ones pierce
# JARVIS_SPEAKER_GATE=1            # voice lock: answer only enrolled voices
# JARVIS_INTERPRETER_LANGS=en,es   # live two-way translator pair


# ── DATA TOOLS (each key unlocks one tool; omit to disable it) ────────────────
# TMDB_API_KEY=            # films/TV/people        themoviedb.org/settings/api
# TMDB_WATCH_REGION=US     # region for "where can I watch X?"
# RAWG_API_KEY=            # video games            rawg.io/apidocs
# WOLFRAM_APP_ID=          # computation            developer.wolframalpha.com
# (News needs no key — the feed list lives in src/news.py.)


# ── CALENDAR ─────────────────────────────────────────────────────────────────
# Outlook.com → Calendar → Share → publish → copy the ICS link. Read-only.
# OUTLOOK_ICAL_URL=


# ── PLEX (optional) ──────────────────────────────────────────────────────────
# PLEX_URL=http://192.168.1.x:32400
# PLEX_TOKEN=


# ── NOTIFICATIONS (optional) ─────────────────────────────────────────────────
# Discord webhook — one-way push for security events and reminders.
# DISCORD_WEBHOOK_URL=
#
# Discord bot — two-way chat with Jarvis from a channel. Restricted tool
# surface (no shell, no filesystem, no code execution). See docs/SETUP.md.
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_ALLOWED_USER_IDS=

# SMTP email alerts (parallel to Discord, independent of it).
# SMTP_USERNAME=
# SMTP_PASSWORD=           # Gmail: a 16-char app password, not your login
# SMTP_TO=


# ── PHONE / REMOTE CONSOLE (optional, LAN-only) ──────────────────────────────
# Blank token = server OFF. Never port-forward this; use Tailscale.
# JARVIS_REMOTE_TOKEN=
# JARVIS_REMOTE_PORT=8765
# JARVIS_TLS_CERT_FILE=    # both set ⇒ HTTPS/WSS (needed for phone mic access)
# JARVIS_TLS_KEY_FILE=


# ── SECURITY MODE (optional) ─────────────────────────────────────────────────
# Spoken passphrase that clears a person-detection challenge.
# JARVIS_SECURITY_PASSPHRASE=
# CAMERA_INDEX=


# ── GPU SPEECH-TO-TEXT OFFLOAD (optional) ────────────────────────────────────
# Point at a CUDA box on the LAN running stt_server/. Falls back to local CPU
# on any failure. Cuts transcription from ~5-10 s to ~1.5-2.5 s.
# STT_SERVER_URL=http://192.168.1.x:8000
# STT_BACKEND=auto         # auto | gpu | cpu


# ── TUNING ───────────────────────────────────────────────────────────────────
# Thresholds, poll intervals, RMS floors, thread caps, retention windows.
# These have sensible defaults and rarely need touching — the full list with
# every default and rationale is in docs/ENV_VARS.md.
